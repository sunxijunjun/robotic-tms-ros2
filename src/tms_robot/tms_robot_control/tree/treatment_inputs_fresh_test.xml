<root BTCPP_format="4">
  <BehaviorTree ID="TreatmentInputsFreshTest">
    <Sequence name="treatment_inputs_fresh_test_seq">
      <ReportStatus
        name="inputs_check_start"
        message="Checking treatment hardware input freshness"/>
      <CheckTreatmentInputsFresh
        name="check_treatment_inputs_fresh"
        require_force="true"
        require_distance="true"
        require_target_pose="true"
        force_freshness_sec="0.20"
        distance_freshness_sec="0.20"
        target_pose_freshness_sec="1.00"/>
      <ReportStatus
        name="inputs_check_done"
        message="Treatment hardware inputs are fresh"/>
    </Sequence>
  </BehaviorTree>
</root>