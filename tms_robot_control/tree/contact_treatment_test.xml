<root BTCPP_format="4">
  <BehaviorTree ID="ContactTreatmentTest">
    <Sequence name="contact_treatment_test_seq">
      <CheckSystemReady
        name="check_system_ready"
        planning_group="ur_arm"/>
      <ReportStatus
        name="contact_treatment_start"
        message="Starting contact treatment test"/>
      <SetAllowedCollision
        name="allow_iccoil_dummy_head_collision"
        link1="iccoil"
        link2="dummy_head"
        allowed="true"/>
      <ApproachTcpZForceBand
        name="approach_force_band"
        planning_group="ur_arm"
        tcp_link="ur10e_tcp"
        min_force_z="{min_force_z}"
        max_force_z="{max_force_z}"
        hard_min_force_z="{hard_min_force_z}"
        step_distance="0.0005"
        max_total_advance="0.050"
        force_freshness_sec="0.20"
        force_wait_timeout_sec="5.0"
        velocity_scale="0.01"
        acceleration_scale="0.01"
        eef_step="0.0001"
        min_fraction="0.90"
        avoid_collisions="true"
        enable_distance_guard="true"
        min_distance_key="min_distance_m"
        distance_freshness_sec="0.20"
        recovery_retract_distance="-0.050"/>
      <ReportStatus
        name="treatment_hold_start"
        message="Starting active force-band treatment hold"/>
      <!-- Hold step/speed must match the approach values: 0.3 mm @ 0.8%
           commanded steps complete without any physical displacement
           (controller deadband), so the hold burned its 50 mm budget while
           the arm sat still (verified from TCP world positions, 166 steps). -->
      <TreatmentForceBandHold
        name="treatment_force_hold"
        planning_group="ur_arm"
        tcp_link="ur10e_tcp"
        duration_key="treatment_duration_sec"
        min_force_z="{min_force_z}"
        max_force_z="{max_force_z}"
        hard_min_force_z="{hard_min_force_z}"
        step_distance="0.0005"
        retract_distance="-0.050"
        max_total_adjustment="0.050"
        force_freshness_sec="0.20"
        velocity_scale="0.01"
        acceleration_scale="0.01"
        eef_step="0.0001"
        min_fraction="0.90"
        enable_distance_guard="true"
        min_distance_key="min_distance_m"
        distance_freshness_sec="0.20"/>
      <SetAllowedCollision
        name="restore_iccoil_dummy_head_collision"
        link1="iccoil"
        link2="dummy_head"
        allowed="false"/>
      <ReportStatus
        name="contact_treatment_done"
        message="Contact treatment test complete"/>
    </Sequence>
  </BehaviorTree>
</root>