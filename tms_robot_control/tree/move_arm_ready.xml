<root BTCPP_format="4">
  <BehaviorTree ID="MoveArmReadyTask">
    <Sequence name="move_arm_ready_seq">
      <CheckSystemReady
        name="check_system_ready"
        planning_group="ur_arm"
        target="ready"/>
      <ReportStatus
        name="arm_ready_start"
        message="Moving arm to ready position"/>
      <!-- Direct PTP only: 'ready' is the same-branch pose straight above the
           work area, so joint-space interpolation gives a near-vertical TCP
           lift. A Cartesian retract here is actively harmful: retracting along
           the tilted coil axis drives the TCP toward the shoulder singularity,
           where the linear path demands large base swings (verified: 39 deg pan
           drift with IK jumps). -->
      <MoveArmNamedTarget
        name="move_ready"
        target="ready"
        planning_group="ur_arm"
        velocity_scale="0.25"
        acceleration_scale="0.25"/>
      <VerifyNamedTargetReached
        name="verify_ready"
        target="ready"
        planning_group="ur_arm"
        tolerance="0.02"/>
      <ReportStatus
        name="arm_ready_done"
        message="Arm moved to ready position"/>
    </Sequence>
  </BehaviorTree>
</root>